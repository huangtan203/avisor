# Tegra234 / Jetson AGX Orin bring-up image.
# This reuses the virt board drivers in a restricted, DTB-driven CPU0 mode.

PLATFORM_DEFINES := -DPLATFORM_VIRT=1 -DPLATFORM_TEGRA=1
BUILD_DIR := build_tegra
OUTDIR := bin_tegra
LINKER_FILE := hypervisor/boards/virt/linker_tegra.ld

TEGRA_DTB_SOURCE ?=
TEGRA_DTB_PATH ?= /boot/avisor/board.dtb
TEGRA_IMAGE_PATH ?= /boot/avisor/Image
TEGRA_UBOOT_INTERFACE ?= mmc
TEGRA_UBOOT_DEVICE ?= 0
TEGRA_UBOOT_PARTITION ?= 1
TEGRA_IMAGE_LOAD_ADDR ?= 0x80000000
TEGRA_DTB_LOAD_ADDR ?= 0x88000000
TEGRA_DEPLOY_DIR := $(OUTDIR)/deploy
TEGRA_DTB_DEPLOY_REL = $(patsubst /%,%,$(TEGRA_DTB_PATH))
TEGRA_IMAGE_DEPLOY_REL = $(patsubst /%,%,$(TEGRA_IMAGE_PATH))
TEGRA_DTB_DEPLOY_FILE = $(TEGRA_DEPLOY_DIR)/$(TEGRA_DTB_DEPLOY_REL)
TEGRA_IMAGE_DEPLOY_FILE = $(TEGRA_DEPLOY_DIR)/$(TEGRA_IMAGE_DEPLOY_REL)
TEGRA_EXTLINUX_FRAGMENT := $(TEGRA_DEPLOY_DIR)/boot/extlinux/avisor.conf.fragment
TEGRA_UBOOT_SCRIPT := $(TEGRA_DEPLOY_DIR)/boot/avisor/avisor-boot.cmd
TEGRA_MANIFEST := $(TEGRA_DEPLOY_DIR)/boot/avisor/manifest.sha256

include Makefile.virt

.PHONY: tegra-image verify-layout tegra-dtb-check tegra-path-check tegra-uboot-args-check extlinux-package uboot-package tegra-preflight tegra-verify-deploy
tegra-image: kernel8.img
	cp $(OUTDIR)/kernel8.img $(OUTDIR)/Image

verify-layout: tegra-image
	@test "$$($(GNU_TOOLS)-nm -n $(BUILD_DIR)/kernel8.elf | awk '$$3 == "_start" { print $$1 }')" = "0000000080080000"
	@python3 -c 'import pathlib,struct; p=pathlib.Path("$(OUTDIR)/Image"); d=p.read_bytes()[:64]; assert len(d)==64; off,size,flags=struct.unpack_from("<QQQ",d,8); magic=struct.unpack_from("<I",d,56)[0]; assert off==0x80000, hex(off); assert size>64 and size<=p.stat().st_size, (size,p.stat().st_size); assert flags==0, hex(flags); assert magic==0x644d5241, hex(magic); print("Tegra arm64 Image verified: entry=0x80080000 offset=0x%x size=%d" % (off,size))'

tegra-path-check:
	@python3 -c 'import pathlib; paths=[pathlib.PurePosixPath("$(TEGRA_IMAGE_PATH)"),pathlib.PurePosixPath("$(TEGRA_DTB_PATH)")]; assert all(p.is_absolute() for p in paths), "deployment paths must be absolute"; assert all(".." not in p.parts for p in paths), "deployment paths must not contain .."; assert len(set(paths))==2, "Image and DTB deployment paths must be distinct"; reserved={pathlib.PurePosixPath("/boot/avisor/avisor-boot.cmd"),pathlib.PurePosixPath("/boot/extlinux/avisor.conf.fragment")}; assert not any(p in reserved for p in paths), "deployment path conflicts with generated boot metadata"; print("Tegra deployment paths verified:", "$(TEGRA_IMAGE_PATH)", "$(TEGRA_DTB_PATH)")'

tegra-uboot-args-check:
	@python3 -c 'import re; interface="$(TEGRA_UBOOT_INTERFACE)"; device="$(TEGRA_UBOOT_DEVICE)"; partition="$(TEGRA_UBOOT_PARTITION)"; assert interface in {"mmc","usb","nvme"}, "unsupported TEGRA_UBOOT_INTERFACE"; assert re.fullmatch(r"[0-9]+",device), "TEGRA_UBOOT_DEVICE must be a decimal number"; assert re.fullmatch(r"[0-9]+",partition), "TEGRA_UBOOT_PARTITION must be a decimal number"; assert int(device)>=0 and int(partition)>0, "invalid U-Boot device or partition"; print("Tegra U-Boot arguments verified:",interface,device+":"+partition)'
	@python3 -c 'import re; values=["$(TEGRA_IMAGE_LOAD_ADDR)","$(TEGRA_DTB_LOAD_ADDR)"]; parsed=[int(value,0) for value in values]; assert all(value>0 and value%0x1000==0 for value in parsed), "U-Boot load addresses must be positive and 4K aligned"; assert parsed[0]==0x80000000, "Image load address must match the linked entry contract"; assert parsed[1]>=parsed[0], "DTB load address must not precede Image"; print("Tegra U-Boot load addresses verified:",*[hex(value) for value in parsed])'

tegra-dtb-check:
	@test -n "$(strip $(TEGRA_DTB_SOURCE))" || { echo "error: set TEGRA_DTB_SOURCE to the board DTB file"; exit 1; }
	@test -f "$(TEGRA_DTB_SOURCE)" || { echo "error: DTB source does not exist: $(TEGRA_DTB_SOURCE)"; exit 1; }
	@python3 -c 'import pathlib,struct; p=pathlib.Path("$(TEGRA_DTB_SOURCE)"); d=p.read_bytes(); assert len(d)>=40, "DTB is shorter than the FDT header"; magic,total,off_struct,off_strings,off_rsvmap,version,last,boot_cpuid,size_strings,size_struct=struct.unpack_from(">10I",d,0); assert magic==0xd00dfeed, hex(magic); assert 40<=total<=len(d), (total,len(d)); assert version>=17 and last<=version, (version,last); assert off_struct+size_struct<=total and off_strings+size_strings<=total; text=d[:total].decode("latin1","ignore"); required=("nvidia,tegra234","arm,gic-v3","arm,armv8-timer","nvidia,tegra194-hsuart"); missing=[item for item in required if item not in text]; assert not missing, "DTB missing compatible markers: "+", ".join(missing); assert "psci" in text, "DTB missing PSCI node"; print("Tegra234 DTB contract verified:",p,"bytes=",total)'

extlinux-package: verify-layout tegra-path-check tegra-dtb-check
	@test -n "$(strip $(TEGRA_DTB_SOURCE))" || { echo "error: set TEGRA_DTB_SOURCE to the board DTB file"; exit 1; }
	@case "$(TEGRA_DTB_PATH)" in /*) ;; *) echo "error: TEGRA_DTB_PATH must be an absolute target path"; exit 1;; esac
	@case "$(TEGRA_IMAGE_PATH)" in /*) ;; *) echo "error: TEGRA_IMAGE_PATH must be an absolute target path"; exit 1;; esac
	@test -f "$(TEGRA_DTB_SOURCE)" || { echo "error: DTB source does not exist: $(TEGRA_DTB_SOURCE)"; exit 1; }
	mkdir -p $(TEGRA_DEPLOY_DIR)/boot/extlinux $(dir $(TEGRA_DTB_DEPLOY_FILE)) $(dir $(TEGRA_IMAGE_DEPLOY_FILE))
	cp $(OUTDIR)/Image $(TEGRA_IMAGE_DEPLOY_FILE)
	cp $(TEGRA_DTB_SOURCE) $(TEGRA_DTB_DEPLOY_FILE)
	@python3 -c 'import pathlib,struct; p=pathlib.Path("$(TEGRA_DTB_DEPLOY_FILE)"); d=p.read_bytes(); assert len(d)>=8; assert struct.unpack_from(">I",d,0)[0]==0xd00dfeed; total=struct.unpack_from(">I",d,4)[0]; assert total<=len(d) and total>=40; print("Tegra DTB verified:", p, "bytes=", total)'
	@printf '%s\n' \
		'LABEL avisor' \
		'      MENU LABEL aVisor Tegra234 EL2 bring-up' \
		'      LINUX $(TEGRA_IMAGE_PATH)' \
		'      FDT $(TEGRA_DTB_PATH)' > $(TEGRA_EXTLINUX_FRAGMENT)
	@python3 -c 'import pathlib; p=pathlib.Path("$(TEGRA_EXTLINUX_FRAGMENT)"); s=p.read_text(); assert "LINUX $(TEGRA_IMAGE_PATH)\n" in s; assert "FDT $(TEGRA_DTB_PATH)\n" in s; print("Tegra extlinux package verified:", p)'
	@echo "Merge $(TEGRA_EXTLINUX_FRAGMENT) into the board extlinux.conf; preserve its recovery entry."

uboot-package: verify-layout tegra-path-check tegra-uboot-args-check tegra-dtb-check
	@test -n "$(strip $(TEGRA_DTB_SOURCE))" || { echo "error: set TEGRA_DTB_SOURCE to the board DTB file"; exit 1; }
	@test -f "$(TEGRA_DTB_SOURCE)" || { echo "error: DTB source does not exist: $(TEGRA_DTB_SOURCE)"; exit 1; }
	@case "$(TEGRA_UBOOT_INTERFACE)" in mmc|usb|nvme) ;; *) echo "error: unsupported TEGRA_UBOOT_INTERFACE"; exit 1;; esac
	@case "$(TEGRA_DTB_PATH)" in /*) ;; *) echo "error: TEGRA_DTB_PATH must be an absolute target path"; exit 1;; esac
	@case "$(TEGRA_IMAGE_PATH)" in /*) ;; *) echo "error: TEGRA_IMAGE_PATH must be an absolute target path"; exit 1;; esac
	@python3 -c 'import pathlib,struct,subprocess; image=pathlib.Path("$(OUTDIR)/Image").read_bytes(); dtb_file=pathlib.Path("$(TEGRA_DTB_SOURCE)").read_bytes(); load=int("$(TEGRA_IMAGE_LOAD_ADDR)",0); dtb=int("$(TEGRA_DTB_LOAD_ADDR)",0); off,size=struct.unpack_from("<QQ",image,8); payload_end=load+off+size; dtb_end=dtb+len(dtb_file); address_limit=1<<48; symbols=subprocess.check_output(["$(GNU_TOOLS)-nm","-n","$(BUILD_DIR)/kernel8.elf"],text=True).splitlines(); image_end=int(next(line.split()[0] for line in symbols if line.split()[-1]=="image_end"),16); assert load==0x80000000, "Image load address must match the linked entry contract"; assert dtb%0x1000==0, hex(dtb); assert image_end>load, hex(image_end); assert dtb>=image_end, "DTB overlaps reserved Image runtime area: 0x%x < 0x%x" % (dtb,image_end); assert dtb_end>dtb and dtb_end<=address_limit, "DTB load range exceeds 48-bit address space"; print("U-Boot load layout verified: image-file=[0x%x,0x%x), image-runtime-end=0x%x, dtb=[0x%x,0x%x)" % (load,payload_end,image_end,dtb,dtb_end))'
	mkdir -p $(dir $(TEGRA_DTB_DEPLOY_FILE)) $(dir $(TEGRA_IMAGE_DEPLOY_FILE))
	cp $(OUTDIR)/Image $(TEGRA_IMAGE_DEPLOY_FILE)
	cp $(TEGRA_DTB_SOURCE) $(TEGRA_DTB_DEPLOY_FILE)
	@python3 -c 'import pathlib,struct; p=pathlib.Path("$(TEGRA_DTB_DEPLOY_FILE)"); d=p.read_bytes(); assert len(d)>=8; assert struct.unpack_from(">I",d,0)[0]==0xd00dfeed; total=struct.unpack_from(">I",d,4)[0]; assert total<=len(d) and total>=40; print("Tegra DTB verified:", p, "bytes=", total)'
	@printf '%s\n' \
		'fatload $(TEGRA_UBOOT_INTERFACE) $(TEGRA_UBOOT_DEVICE):$(TEGRA_UBOOT_PARTITION) $(TEGRA_IMAGE_LOAD_ADDR) $(TEGRA_IMAGE_PATH)' \
		'fatload $(TEGRA_UBOOT_INTERFACE) $(TEGRA_UBOOT_DEVICE):$(TEGRA_UBOOT_PARTITION) $(TEGRA_DTB_LOAD_ADDR) $(TEGRA_DTB_PATH)' \
		'booti $(TEGRA_IMAGE_LOAD_ADDR) - $(TEGRA_DTB_LOAD_ADDR)' > $(TEGRA_UBOOT_SCRIPT)
	@python3 -c 'import pathlib; p=pathlib.Path("$(TEGRA_UBOOT_SCRIPT)"); s=p.read_text(); assert "fatload $(TEGRA_UBOOT_INTERFACE) $(TEGRA_UBOOT_DEVICE):$(TEGRA_UBOOT_PARTITION) $(TEGRA_IMAGE_LOAD_ADDR) $(TEGRA_IMAGE_PATH)\n" in s; assert "booti $(TEGRA_IMAGE_LOAD_ADDR) - $(TEGRA_DTB_LOAD_ADDR)\n" in s; print("U-Boot script verified:", p)'
	@echo "Review $(TEGRA_UBOOT_SCRIPT) before executing it; keep a recovery boot entry."

tegra-preflight: verify-layout tegra-path-check tegra-uboot-args-check tegra-dtb-check uboot-package extlinux-package
	@python3 -c 'import pathlib; p=pathlib.Path("$(TEGRA_UBOOT_SCRIPT)"); s=p.read_text(); assert s.endswith("booti $(TEGRA_IMAGE_LOAD_ADDR) - $(TEGRA_DTB_LOAD_ADDR)\n"); print("Tegra preflight passed:"); print("  Image: $(OUTDIR)/Image"); print("  DTB: $(TEGRA_DTB_SOURCE) -> $(TEGRA_DTB_PATH)"); print("  entry: 0x80080000 (load $(TEGRA_IMAGE_LOAD_ADDR))"); print("  U-Boot: $(TEGRA_UBOOT_INTERFACE) $(TEGRA_UBOOT_DEVICE):$(TEGRA_UBOOT_PARTITION)")'
	@python3 -c 'import hashlib,pathlib; root=pathlib.Path("$(TEGRA_DEPLOY_DIR)"); files=[pathlib.Path("$(TEGRA_IMAGE_DEPLOY_REL)"),pathlib.Path("$(TEGRA_DTB_DEPLOY_REL)"),pathlib.Path("boot/avisor/avisor-boot.cmd"),pathlib.Path("boot/extlinux/avisor.conf.fragment")]; assert len(set(files))==4, "deployment paths must be distinct"; out=pathlib.Path("$(TEGRA_MANIFEST)"); lines=[]; [lines.append("%s  %s" % (hashlib.sha256((root/f).read_bytes()).hexdigest(),f.as_posix())) for f in files]; out.write_text("\n".join(lines)+"\n"); print("Deployment manifest generated:",out)'
	@echo "Review deployment files under $(TEGRA_DEPLOY_DIR) before copying them to the target."

tegra-verify-deploy:
	@test -f "$(TEGRA_MANIFEST)" || { echo "error: deployment manifest is missing; run tegra-preflight first"; exit 1; }
	@python3 -c 'import pathlib; root=pathlib.Path("$(TEGRA_DEPLOY_DIR)"); manifest=pathlib.Path("$(TEGRA_MANIFEST)"); expected={"$(TEGRA_IMAGE_DEPLOY_REL)","$(TEGRA_DTB_DEPLOY_REL)","boot/avisor/avisor-boot.cmd","boot/extlinux/avisor.conf.fragment"}; lines=manifest.read_text().splitlines(); names={line.split("  ",1)[1] for line in lines if "  " in line}; assert names==expected, (names,expected); assert all((root/pathlib.Path(name)).is_file() for name in expected), "deployment file missing"; print("Deployment manifest entries verified:",len(names))'
	@cd $(TEGRA_DEPLOY_DIR) && sha256sum -c boot/avisor/manifest.sha256
	@echo "Tegra deployment verification passed: $(TEGRA_DEPLOY_DIR)"
